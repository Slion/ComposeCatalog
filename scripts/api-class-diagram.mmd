classDiagram
direction LR

%% ===== Screen (top-level composable) =====
class Catalog {
  <<composable - screen>>
  +title: String
  +pages: List~Page~
  +rootContent: ContentBuilder
  +adaptiveInfo: WindowAdaptiveInfo?
  +singlePaneOnly: Boolean
  +options: CatalogOptions
  +onBack: OnBack
}

class CatalogOptions {
  +hingePolicy: HingePolicy
  +twoPanesOnMediumWidth: Boolean
  +fadingEdges: Boolean
}

class ScreenAdaptive {
  <<internal>>
  +isTwoPane: Boolean
  +directive: PaneScaffoldDirective
  rememberScreenAdaptive()*
  quantizedAdaptiveInfo()*
  paneScaffoldDirective()*
}

class ListPane {
  <<composable - internal>>
}
class DetailPane {
  <<composable - internal>>
}
class SearchPill {
  <<composable - internal>>
}
class BreadcrumbBar {
  <<composable - internal>>
}
class SearchEntry {
  <<data - internal>>
  +id: Int
  +page: Page?
  +path: String
  +entry: SearchIndexEntry?
}

%% ===== Page model =====
class Page {
  <<data - model>>
  +id: String
  +title: String
  +summary: String?
  +icon: Composable?
  +subPages: List~Page~
  +onClick: OnClick?
  +contentVersion: Int
  +content: ContentBuilder
  walkPages()*
  findPage(pages, id)*
  findPagePath(pages, id)*
  searchPages(pages, index, query)*
}

class PageMatch {
  <<data - search result>>
  +page: Page
  +matches: List~SearchIndexEntry~
}

%% ===== Search =====
class SearchIndex {
  <<static functions>>
  buildSearchIndex(pages)*
  buildSearchIndex(rootContent)*
}
class SearchIndexEntry {
  <<data>>
  +key: String?
  +title: String
  +summary: String?
  +index: Int
  +titleLowercase: String
  +summaryLowercase: String?
}

%% ===== State / persistence =====
class Store {
  <<interface>>
  +get(key): T?
  +asMap(): Map~String, Any~
  +toMutableStore(): MutableStore
}
class MutableStore {
  <<interface>>
  +set(key, value: T?)
  +remove(key)
  +clear()
}
class MapStore
class MutableMapStore

class LocalStore {
  <<state flow>>
  LocalStore
  createDefaultStore()*
  createStore()*
  ProvideStore()*
  rememberValue(key)*
}

%% ===== Theming =====
class PreferenceTheme {
  +categoryPadding: PaddingValues
  +categoryColor: Color
  +padding: PaddingValues
  +titleColor: Color
  +titleTextStyle: TextStyle
  +summaryColor: Color
  +summaryTextStyle: TextStyle
  +dividerHeight: Dp
  preferenceTheme()*
  LocalPreferenceTheme
}

%% ===== Row widgets (each = LazyListScope builder + Composable) =====
class Item {
  <<composable - item family>>
}
class BasicItem {
  <<composable>>
}
class ItemCheckbox {
  <<composable>>
}
class ItemSwitch {
  <<composable>>
}
class ItemRadio {
  <<composable>>
}
class ItemSlider {
  <<composable>>
}
class ItemTextField {
  <<composable>>
}
class ItemList {
  <<composable>>
}
class ItemMultiSelectList {
  <<composable>>
}
class ItemActions {
  <<composable>>
}
class ItemActionIconButton {
  <<composable>>
}
class ItemActionsSwitch {
  <<composable>>
}
class ItemFooter {
  <<composable>>
}
class Section {
  <<composable - section header>>
}
class LiveItemSlider {
  <<composable - sample>>
}
class ColorItem {
  <<composable - sample>>
}
class AccentColorOption {
  <<data>>
}

%% ===== Card =====
class CardStyle {
  <<sealed>>
  Filled
  Elevated
  Outlined
}
class CardItem {
  <<data>>
  +title: String
  +summary: String?
  +icon: Composable?
  +value: String
}
class CardRow {
  <<data>>
  +items: List~CardItem~
}
class CardGroup {
  <<composable>>
}
class CardScope {
  <<dsl scope>>
}
class CardGroupScope {
  <<dsl scope>>
}

%% ===== External (material3-adaptive) =====
class WindowAdaptiveInfo {
  <<external - m3 adaptive>>
}
class HingePolicy {
  <<external - m3 adaptive>>
}

%% ===== Relationships =====
MutableStore --|> Store
MapStore --|> Store
MutableMapStore --|> MutableStore

Catalog --> Page : pages
Catalog --> CatalogOptions : options
CatalogOptions --> HingePolicy : hingePolicy
Catalog ..> ScreenAdaptive : remembers
Catalog ..> PreferenceTheme : consumes
Catalog ..> SearchIndex : builds
Catalog o-- ListPane : composes
Catalog o-- DetailPane : composes
ListPane o-- SearchPill : composes
ListPane ..> BreadcrumbBar : single-pane
ListPane ..> SearchEntry : search results
DetailPane ..> SearchEntry : search results
DetailPane ..> Page : renders content
SearchPill ..> SearchEntry : submits

Page --> Page : subPages
PageMatch --> Page : page
PageMatch --> SearchIndexEntry : matches
SearchIndex ..> SearchIndexEntry : builds
SearchIndex ..> Page : walks
SearchEntry ..> SearchIndexEntry : entry

ItemCheckbox ..> LocalStore : reads state
ItemSlider ..> LocalStore : reads state
ItemTextField ..> LocalStore : reads state
Item ..> PreferenceTheme : styled by
Item ..> LocalStore : reads state
DetailPane ..> Item : renders items

BasicItem --|> Item : is a
ItemCheckbox --|> Item : is a
ItemSwitch --|> Item : is a
ItemRadio --|> Item : is a
ItemSlider --|> Item : is a
ItemTextField --|> Item : is a
ItemList --|> Item : is a
ItemMultiSelectList --|> Item : is a
ItemActions --|> Item : is a
ItemActionIconButton --|> Item : is a
ItemActionsSwitch --|> Item : is a
ItemFooter --|> Item : is a
Section --|> Item : is a

CardGroup ..> CardScope : dsl
CardGroup ..> CardGroupScope : dsl
CardGroup ..> CardStyle : style
CardRow --> CardItem : items
CardRow --|> Item : is a
LiveItemSlider --|> Item : is a
ColorItem --|> Item : is a
ColorItem ..> AccentColorOption : options
